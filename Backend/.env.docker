APP_NAME=TravelPlannerAgent
APP_VERSION=1.0.0
ENV=docker
DEBUG=True

HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:5173

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=TravelPlannerAgent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DARIONHANWUL

DATABASE_URL=postgresql://postgres:DARIONHANWUL@postgres:5432/TravelPlannerAgent

JWT_SECRET=travelplanner_secret_key
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

WEAVIATE_URL=http://weaviate:8080
WEAVIATE_CLASS=TravelKnowledge

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

LOG_LEVEL=INFO
LOG_DIR=logs